# Telegram Configuration
# Get these from @BotFather and @userinfobot on Telegram
Telegram_bot_token=YOUR_BOT_TOKEN_HERE
telegram_user_id=YOUR_USER_ID_HERE

# Optional: API-Football.com (RapidAPI)
# Free tier available at: https://rapidapi.com/api-sports/api/api-football
# This provides more reliable match data than ESPN scraping
FOOTBALL_API_KEY=YOUR_API_KEY_HERE
